{
  "redirects": [
    { "source": "/hq", "destination": "/hq/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/prices/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/prices",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
